# ─────────────────────────────────────────────────────────────
# Eski Para Market – yapılandırma örneği
# Bu dosyayı .env olarak kopyalayın. .env repoya EKLENMEZ (.gitignore).
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
# Kanonik adresler, sitemap ve CSRF köken kontrolü için kullanılır (sonunda / olmadan).
SITE_URL=http://localhost:3000
# Ters vekil (nginx, Cloudflare…) arkasında çalışıyorsanız 1 yapın; alıcı IP'si doğru okunur.
TRUST_PROXY=0

# ── Veri sağlayıcı ───────────────────────────────────────────
# demo    : data/catalog/*.json (referans siteden aktarılan katalog). Gerçek ödeme/sipariş YOK.
# shopify : Storefront API. Ürün, fiyat, stok ve sepet için doğruluk kaynağı Shopify olur.
CATALOG_PROVIDER=demo

# Demo sepette satır başına üst sınır (kaynak site stok adedi yayınlamıyor).
DEMO_MAX_QTY_PER_LINE=5

# remote: görseller eskiparamarket.com'dan; local: data/media (npm run images:mirror sonrası)
IMAGE_MODE=remote

# ── Shopify Storefront API (vitrin, yalnızca sunucu tarafı) ──
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_API_VERSION=2026-10
# Tercih edilen: özel (private/delegate) token. Sunucuda kalır, tarayıcıya gönderilmez.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Özel token yoksa herkese açık token (yine yalnızca sunucudan kullanılır).
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
# Kategori ağacının okunacağı navigasyon menüsü
SHOPIFY_MENU_HANDLE=main-menu
SHOPIFY_COUNTRY=TR
SHOPIFY_LANGUAGE=TR
SHOPIFY_TIMEOUT_MS=8000

# ── Shopify Admin API (YALNIZCA tools/shopify/import-catalog.mjs) ──
# Vitrin uygulaması bu değişkenleri okumaz. Üretim sunucusuna koymanız gerekmez.
SHOPIFY_ADMIN_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2026-10
