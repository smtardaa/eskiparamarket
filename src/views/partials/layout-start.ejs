<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %><%= title.includes(site.name) ? '' : ` | ${site.name}` %></title>
  <% if (description) { %><meta name="description" content="<%= description %>"><% } %>
  <% if (noindex) { %><meta name="robots" content="noindex, follow"><% } %>
  <% if (canonical) { %><link rel="canonical" href="<%= canonical %>"><% } %>
  <meta property="og:site_name" content="<%= site.name %>">
  <meta property="og:title" content="<%= title %>">
  <% if (description) { %><meta property="og:description" content="<%= description %>"><% } %>
  <meta property="og:locale" content="tr_TR">
  <% if (typeof ogImage !== 'undefined' && ogImage) { %><meta property="og:image" content="<%= ogImage %>"><% } %>
  <meta name="theme-color" content="#14263D">
  <link rel="icon" href="/static/img/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/vendor/fonts/inter/inter-latin-ext-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/static/css/fonts.css">
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/static/css/tokens.css">
  <link rel="stylesheet" href="/static/css/app.css">
  <% for (const ld of jsonLd) { %><script type="application/ld+json"><%- ldJson(ld) %></script>
  <% } %>
</head>
<body data-mode="<%= site.mode %>">
  <a class="skip-link" href="#main">İçeriğe geç</a>
  <%- include('header') %>
  <main id="main" tabindex="-1">
