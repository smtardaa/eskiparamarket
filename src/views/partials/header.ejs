<%
  const roots = nav.filter((c) => c.kind !== 'collection');
  const cartCount = (typeof cart !== 'undefined' && cart) ? cart.totalQuantity : 0;
  const searchValue = typeof reqQuery.q === 'string' ? reqQuery.q : '';
%>
<% if (site.mode === 'demo') { %>
<div class="demo-bar" role="note">
  <div class="container-xl">
    <strong>Demo mağaza.</strong> <span class="d-none d-md-inline">Ürünler eskiparamarket.com’dan aktarıldı; bu sürümde gerçek ödeme veya sipariş oluşturulmaz.</span><span class="d-md-none">Gerçek ödeme ve sipariş oluşturulmaz.</span>
  </div>
</div>
<% } %>
<header class="site-header">
  <div class="container-xl header-main">
    <button class="icon-btn d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobile-nav" aria-controls="mobile-nav" aria-label="Kategoriler menüsünü aç">
      <svg class="icon" aria-hidden="true"><use href="/static/img/icons.svg#menu"></use></svg>
    </button>
    <a class="brand" href="/" aria-label="<%= site.name %> ana sayfa">
      <svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="18.5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="20" cy="20" r="13.5" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="1.5 2.2"/><text x="20" y="25.5" text-anchor="middle" font-family="Source Serif 4 Variable, Georgia, serif" font-size="15" font-weight="700" fill="currentColor">EP</text></svg>
      <span class="brand-text"><span class="brand-name">Eski Para Market</span><span class="brand-tag">Numismatik koleksiyon</span></span>
    </a>
    <form class="header-search" action="/arama" method="get" role="search">
      <label class="visually-hidden" for="site-search">Ürün, ülke veya ürün kodu ara</label>
      <input id="site-search" class="form-control" type="search" name="q" value="<%= searchValue %>" placeholder="Ürün, ülke, yıl veya ürün kodu ara" maxlength="100" autocomplete="off">
      <button class="search-btn" type="submit" aria-label="Ara"><svg class="icon" aria-hidden="true"><use href="/static/img/icons.svg#search"></use></svg></button>
    </form>
    <nav class="header-actions" aria-label="Hesap ve sepet">
      <a class="icon-btn" href="/favoriler" aria-label="Favorilerim">
        <svg class="icon" aria-hidden="true"><use href="/static/img/icons.svg#heart"></use></svg>
        <span class="badge-count" data-count="favorites" hidden>0</span>
      </a>
      <a class="icon-btn d-none d-sm-inline-flex" href="/karsilastir" aria-label="Karşılaştırma listesi">
        <svg class="icon" aria-hidden="true"><use href="/static/img/icons.svg#compare"></use></svg>
        <span class="badge-count" data-count="compare" hidden>0</span>
      </a>
      <a class="icon-btn cart-btn" href="/sepet" aria-label="Sepetim, <%= cartCount %> ürün">
        <svg class="icon" aria-hidden="true"><use href="/static/img/icons.svg#bag"></use></svg>
        <span class="d-none d-md-inline">Sepet</span>
        <span class="badge-count badge-cart" data-count="cart" <%= cartCount ? '' : 'hidden' %>><%= cartCount %></span>
      </a>
    </nav>
  </div>

  <nav class="category-nav d-none d-lg-block" aria-label="Kategoriler">
    <div class="container-xl">
      <ul class="cat-menu">
        <% roots.forEach((c, i) => { %>
        <li class="cat-item">
          <% if (c.children.length) { %>
          <button type="button" class="cat-toggle" aria-expanded="false" aria-controls="mega-<%= c.id %>"><%= c.name %><svg class="icon icon-sm" aria-hidden="true"><use href="/static/img/icons.svg#chevron-down"></use></svg></button>
          <div class="mega" id="mega-<%= c.id %>" hidden>
            <div class="mega-head">
              <a class="mega-all" href="<%= c.url %>">Tüm <%= c.name %> <span class="count">(<%= c.productCount %>)</span></a>
              <% if (c.children.length > 24) { %>
              <label class="mega-filter"><span class="visually-hidden"><%= c.name %> içinde filtrele</span><input type="search" class="form-control form-control-sm" placeholder="Ülke ara…" data-mega-filter></label>
              <% } %>
            </div>
            <ul class="mega-list <%= c.children.length > 24 ? 'is-dense' : '' %>">
              <% c.children.forEach((ch) => { %>
              <li><a href="<%= ch.url %>"><%= ch.name %> <span class="count"><%= ch.productCount %></span></a>
                <% if (ch.children.length) { %><ul class="mega-sub"><% ch.children.forEach((g) => { %><li><a href="<%= g.url %>"><%= g.name %></a></li><% }) %></ul><% } %>
              </li>
              <% }) %>
            </ul>
          </div>
          <% } else { %>
          <a class="cat-link" href="<%= c.url %>"><%= c.name %></a>
          <% } %>
        </li>
        <% }) %>
      </ul>
    </div>
  </nav>
</header>

<div class="offcanvas offcanvas-start mobile-nav" tabindex="-1" id="mobile-nav" aria-labelledby="mobile-nav-title">
  <div class="offcanvas-header">
    <h2 class="offcanvas-title h5" id="mobile-nav-title">Kategoriler</h2>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Menüyü kapat"></button>
  </div>
  <div class="offcanvas-body">
    <ul class="tree">
      <% roots.forEach((c) => { %>
      <li>
        <% if (c.children.length) { %>
        <details>
          <summary><%= c.name %> <span class="count"><%= c.productCount %></span></summary>
          <ul>
            <li><a href="<%= c.url %>">Tümünü göster</a></li>
            <% c.children.forEach((ch) => { %><li><a href="<%= ch.url %>"><%= ch.name %> <span class="count"><%= ch.productCount %></span></a></li><% }) %>
          </ul>
        </details>
        <% } else { %><a href="<%= c.url %>"><%= c.name %></a><% } %>
      </li>
      <% }) %>
    </ul>
    <hr>
    <ul class="tree tree-plain">
      <li><a href="/favoriler">Favorilerim</a></li>
      <li><a href="/karsilastir">Karşılaştır</a></li>
      <li><a href="/iletisim">İletişim</a></li>
      <li><a href="/sayfa/hakkimizda">Hakkımızda</a></li>
    </ul>
  </div>
</div>
